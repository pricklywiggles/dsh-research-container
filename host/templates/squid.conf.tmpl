# Squid as the explicit egress gate for the dsh container network.
# Only dshnet may use it, and only to domains in the allowlist.

http_port ${SQUID_PORT}

acl dshnet src ${SUBNET}
acl allowed_domains dstdomain "${BREW_PREFIX}/etc/squid-dsh-allowlist.txt"
acl SSL_ports port 443
acl Safe_ports port 80 443
acl CONNECT method CONNECT

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow dshnet allowed_domains
http_access deny all

cache deny all
access_log stdio:${LOG_DIR}/squid-dsh-access.log
forwarded_for delete
via off
