# dsh box configuration. Copy to config.env and edit.
#
#   cp config.example.env config.env
#
# config.env is gitignored. Every value here has a working default except
# MODEL_HOST, which depends on where your model server runs.
#
# Values your machine already knows (your username, uid, and Homebrew prefix)
# are detected at runtime and are deliberately not settings.

# ---------------------------------------------------------------- model -----

# Where the OpenAI-compatible model server listens, as host:port.
# Common cases:
#   llama.cpp / Ollama / LM Studio on this same Mac ... 127.0.0.1:8090
#   another machine on your LAN or tailnet ............ 10.0.0.5:8090
# The container never talks to this address directly. A relay on the gateway
# forwards to it, so the container stays unaware of your network.
# Left blank on purpose: no common server uses the same port, and a wrong
# guess fails silently as a relay that never connects. ./setup.sh finds the
# server for you; ./doctor.sh refuses to pass while this is empty.
MODEL_HOST=

# Model id as the server reports it at GET /v1/models.
# Defaults to Qwen3.8-27B because that is what this box was built and tuned
# against, and docs/10-qwen-and-local-models.md documents its failure modes.
# Any OpenAI-compatible model works: change it here and the entrypoint
# reconciles dsh-home/settings.yaml at the next ./run.sh.
MODEL_ID=qwen38

# Optional API key for the model server. Leave as-is when the server ignores
# auth, which local llama.cpp does by default.
MODEL_API_KEY=unused

# ---------------------------------------------------------------- network ---

# Private subnet for the locked-down container network. It must not collide
# with anything your Mac already routes: check with `netstat -rn -f inet`.
# The gateway is always the .1 address of this subnet.
SUBNET=192.168.66.0/24
SUBNET6=fd66:2a5:1::/64

# Host loopback port for the dsh web UI. Browse http://127.0.0.1:$UI_PORT
# using the IPv4 literal, never "localhost": the publish binds IPv4 only, and
# on a non-localhost origin the browser withholds crypto.randomUUID and the
# workspace picker breaks.
UI_PORT=3080

# Gateway ports the container is allowed to reach. Each is a hole in the
# firewall, so change them only if they collide with something local.
# 8888 is a common Jupyter port; 3128 is the classic proxy port.
SQUID_PORT=3128
MODEL_RELAY_PORT=8090
SEARXNG_PORT=8888
CRAWL4AI_PORT=8890

# ---------------------------------------------------------------- host ------

# Reverse-DNS prefix for the launchd jobs this installs and their log files.
# Change it only if you want a different name in launchctl and $(brew
# --prefix)/var/logs. setup-host.sh removes daemons left by an old prefix.
LABEL_PREFIX=local.dshbox

# ---------------------------------------------------------------- container -

# Resources for the agent container.
DSH_CPUS=4
DSH_MEMORY=8G

# run.sh wipes and recreates the image build cache once it passes this many
# GB; the next build then runs cold (roughly four minutes) and re-warms it.
# The cache only exists to make rebuilds fast, and apple/container never
# shrinks it on its own. Must sit ABOVE the size of one warm build (about
# 16G for this image), or every build wipes the cache it just made and runs
# cold forever. 0 keeps the cache with no limit. run.sh also prunes the
# image generation each rebuild replaces, unconditionally.
BUILDER_CACHE_MAX_GB=25
